{
  "name": "stream-debugger",
  "version": "0.1.0",
  "private": true,
  "description": "DevTools for debugging streaming LLM responses and real-time data",
  "license": "MIT",
  "author": "Matt Smith <runner_28@hotmail.com>",
  "packageManager": "pnpm@8.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --filter '!@stream-debugger/example-*' --parallel build",
    "test": "pnpm -r --filter '!@stream-debugger/example-*' --parallel test",
    "lint": "pnpm -r --filter '!@stream-debugger/example-*' --parallel lint",
    "typecheck": "pnpm -r --filter '!@stream-debugger/example-*' --parallel typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.3"
  }
}
